    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const lead = item.json;\n  let score = 0;\n\n  const phone = String(lead.phone ?? '').trim();\n  const company = String(lead.company ?? '').trim();\n  const service = String(lead.service ?? '').toLowerCase();\n  const message = String(lead.message ?? '').trim();\n\n  // Budget: 2 points\n  if (Number(lead.budget) >= 100000) {\n    score += 2;\n  }\n\n  // Service relevance: 2 points\n  if (service.includes('automation')) {\n    score += 2;\n  }\n\n  // Business information\n  if (company) score += 1;\n  if (phone) score += 1;\n\n  // Message quality\n  if (message.length >= 30) {\n    score += 1;\n  }\n\n  return {\n    json: {\n      ...lead,\n      qualificationScore: score,\n      qualificationStatus: score >= 4\n        ? 'Qualified'\n        : 'Needs Review'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        192
      ],
